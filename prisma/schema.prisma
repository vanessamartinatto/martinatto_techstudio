generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  projectType String
  description String
  lang        String   @default("it")
  createdAt   DateTime @default(now())
}