# ============================================================
#  Martinatto Tech_Studio — variáveis de ambiente
#  Copie para .env (ou .env.local) e preencha
# ============================================================

# Banco de dados (SQLite local)
DATABASE_URL=file:./db/custom.db

# ------------------------------------------------------------
# FORMULÁRIO DE CONTATO → E-MAIL (necessário para ativar o envio)
# ------------------------------------------------------------

# Destinatário das notificações do formulário:
CONTACT_EMAIL=info@martinatto.it

# Conta REMETENTE (caixa IONOS do domínio):
SMTP_HOST=smtp.ionos.it
SMTP_PORT=465
SMTP_USER=info@martinatto.it

# Senha da caixa info@martinatto.it (a mesma do webmail IONOS):
SMTP_PASS=TROQUE_PELA_SUA_SENHA

# ------------------------------------------------------------
# Como ativar:
#   1. Preencha SMTP_PASS com a senha real
#   2. Reinicie o servidor (Ctrl+C e rode `bun run dev` ou `npm run dev`)
#   3. Envie um teste pelo formulário do site
#   4. Resposta esperada da API: {"ok":true,"emailStatus":"sent"}
#      - "not_configured" = SMTP_PASS vazio
#      - "failed"         = senha/host errados (veja o terminal)
# Dica: a senha pode ficar apenas no .env.local (o .gitignore já
# cobre .env* — nada é versionado no git).
# ------------------------------------------------------------
